# Application Configuration
APP_PORT=8080
APP_ENV=production

# Database Configuration
DATABASE_DSN=postgres://username:password@localhost:5432/expensedb?sslmode=disable

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# AA (Account Aggregator) Configuration
AA_BASE_URL=https://sandbox.example-aa.com
AA_API_KEY=your-aa-api-key
AA_CLIENT_ID=your-aa-client-id
AA_CLIENT_SECRET=your-aa-client-secret
AA_ENC_PUBLIC_KEY=your-aa-enc-public-key
AA_ENC_PRIVATE_KEY=your-aa-enc-private-key
AA_PROVIDER=mock

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Bank Verification Configuration
BANK_VERIFICATION_API_KEY=your-bank-verification-api-key
BANK_VERIFICATION_API_URL=https://api.bankverification.com/v1/verify
BANK_VERIFICATION_ENABLED=true 